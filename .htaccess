# ============================================================
# Apache 配置文件
# ============================================================
#
# 访问方式（两套都能用）：
#   原生路径（始终可用，零 rewrite）：
#     首页            /index.php
#     平台详情页      /platform.php?source=baidu
#     API            /api/index.php/baidu
#
#   Clean URL（需 mod_rewrite 已开启）：
#     首页            /
#     平台详情页      /platform/baidu         或  /platform.php/baidu
#     平台历史存档    /platform/baidu/2026-11-10
#     API            /api/V1/baidu            或  /api/index.php/baidu
#     设置页          /setting
#
# Nginx 用户：本文件无效，请把 nginx.htaccess 的规则贴到 nginx.conf
# ============================================================

# ---- 默认首页 ----
DirectoryIndex index.php index.html

# ---- 404 错误页 ----
ErrorDocument 404 /404.php

<IfModule mod_rewrite.c>
    RewriteEngine On

    # ---- Clean URL: /platform/baidu → /platform.php?source=baidu ----
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^platform/([a-z0-9_]+)(?:/(\d{4}-\d{2}-\d{2}))?$ platform.php?source=$1&date=$2 [L,NC]

    # ---- 短 URL: /baidu 或 /baidu/2026-11-15 → /platform.php?source=xxx ----
    # 排除已存在的路径：platform/、api/、setting、sitemap、status、apidoc、debug、archive、真实文件/目录
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} !^/(platform|api|setting|sitemap|status|apidoc|debug|404|archive)
    RewriteRule ^([a-z0-9_]+)(?:/(\d{4}-\d{2}-\d{2}))?$ platform.php?source=$1&date=$2 [L,NC]

    # ---- 归档页 Clean URL: /archive/baidu → /archive.php?source=baidu ----
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^archive/([a-z0-9_]+)$ archive.php?source=$1 [L,NC]

    # ---- Clean URL: /api/V1/baidu → /api/index.php/V1/baidu ----
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^api/(.+)$ api/index.php/$1 [L,NC]

    # ---- /setting → /setting.php ----
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^setting$ setting.php [L,NC]

    # ---- /status → /status.php ----
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^status$ status.php [L,NC]

    # ---- /apidoc → /apidoc.php ----
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^apidoc$ apidoc.php [L,NC]

    # ---- /debug → /debug.php ----
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^debug$ debug.php [L,NC]

    # ---- /sitemap → /sitemap.php ----
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^sitemap$ sitemap.php [L,NC]

    # ---- /sitemap.xml → /sitemap.php（爬虫标准路径）----
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^sitemap\.xml$ sitemap.php [L,NC]
</IfModule>

# ============================================================
# 静态资源缓存
# ============================================================

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpeg "7Days"
    ExpiresByType image/png "7Days"
    ExpiresByType image/gif "7Days"
    ExpiresByType image/webp "7Days"
    ExpiresByType image/svg+xml "7Days"
    ExpiresByType image/x-icon "7Days"
    ExpiresByType text/css "7Days"
    ExpiresByType application/javascript "7Days"
    ExpiresByType text/javascript "7Days"
    ExpiresByType font/ttf "30Days"
    ExpiresByType font/otf "30Days"
    ExpiresByType font/woff "30Days"
    ExpiresByType font/woff2 "30Days"
    ExpiresByType application/font-woff "30Days"
    ExpiresByType application/font-woff2 "30Days"
    ExpiresByType text/html "0"
    ExpiresByType application/xhtml+xml "0"
</IfModule>

# ============================================================
# Gzip 压缩（mod_deflate）
#   传输时把 CSS/JS/HTML/JSON/字体/XML 压小，浏览器收到后自动解压
#   注意：这是"传输压缩"，不是 minify（代码删空格），两者可以叠加
# ============================================================

<IfModule mod_deflate.c>
    # 压缩以下 MIME 类型
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/json
    AddOutputFilterByType DEFLATE application/xml
    AddOutputFilterByType DEFLATE text/xml
    AddOutputFilterByType DEFLATE image/svg+xml
    AddOutputFilterByType DEFLATE font/ttf
    AddOutputFilterByType DEFLATE font/otf
    AddOutputFilterByType DEFLATE font/woff
    AddOutputFilterByType DEFLATE font/woff2
    AddOutputFilterByType DEFLATE application/font-woff
    AddOutputFilterByType DEFLATE application/font-woff2

    # 图片（jpg/png/gif/webp）本身已经是压缩格式，不用再 gzip
    # 排除不需要压缩的请求
    SetEnvIfNoCase Request_URI "\.(?:gif|jpe?g|png|webp|ico)$" no-gzip dont-vary
</IfModule>

# ============================================================
# 安全相关
# ============================================================

# ---- 禁止访问 .htaccess 自身 ----
<Files .htaccess>
    Order Allow,Deny
    Deny from all
</Files>

# ---- 禁止访问以点开头的隐藏文件/目录（.env、.git、.htpasswd 等） ----
<FilesMatch "^\.">
    Order Allow,Deny
    Deny from all
</FilesMatch>

# ---- 禁止直接访问核心目录 ----
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(core|cache|api/utils)/ - [F,L,NC]
</IfModule>

# ---- 禁止目录列表 ----
Options -Indexes

# ============================================================
# HTTP 安全响应头（上线时启用，本地开发可注释）
# ============================================================
<IfModule mod_headers.c>
    # 防点击劫持：禁止任何 frame/iframe 嵌入本站页面
    Header always set X-Frame-Options "SAMEORIGIN"

    # 防 MIME 嗅探：浏览器不能自动猜测文件类型
    Header always set X-Content-Type-Options "nosniff"

    # 引用策略：只把 Referer 发给同源，外链不发完整 URL
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # 权限策略：禁止摄像头/麦克风/地理位置/自动播放等
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), autoplay=(self), payment=()"

    # 内容安全策略（CSP）—— 按需开启，开启后所有 inline style/script 需加 hash
    # Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: https:; connect-src 'self' https:; frame-ancestors 'self';"
</IfModule>

# ============================================================
# HTTPS 强制跳转
#   上线用宝塔面板的"强制 SSL"开关接管，这里不再重复
#   本地 phpStudy 开发也不需要这层跳转
# ============================================================
