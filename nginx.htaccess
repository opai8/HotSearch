# ============================================================
# nginx.htaccess — phpStudy 本地专用（粘贴到 server { } 里用）
# ============================================================
# 最后，Nginx → 重启


# 第 1 步：清理 phpStudy 自动生成的 include
#   打开  Extensions\Nginx\conf\vhosts\域名_80.conf
#   找到 server { } 里那行没用的 include ".../nginx.htaccess"; 注释或删掉


# 第 2 步：开 Gzip（全局一次性）
#   打开  \Nginx\conf\nginx.conf
#   找到 http { } 里的 gzip 部分，替换为下面的代码块（直接复制）
#   text/html 默认注释原因：Nginx 内置，重复会产生 warn 日志

# ---------- 第 2 步 Gzip 代码 ----------
gzip on;
gzip_vary on;
gzip_proxied any;
gzip_comp_level 6;
gzip_min_length 256;
gzip_types
  # text/html
  text/css text/plain
  application/javascript application/json
  application/xml text/xml image/svg+xml
  font/ttf font/otf font/woff font/woff2
  application/font-woff application/font-woff2;
# ---------- Gzip 代码结束 ----------


# 第 3 步：把下面的代码，粘贴到第 1 步那个 server { } 里
# ============================================================


# ============================================================
# ① 安全加固
# ============================================================
location /cache/      { deny all; return 403; }
location /logs/       { deny all; return 403; }
location /api/utils/  { deny all; return 403; }
location ~* /\.       { deny all; return 403; }
location ~* ^/core/$                                  { deny all; return 403; }
location ~* ^/core/.*\.(conf|ini|bak|old|log|md|sh)$  { deny all; return 403; }

add_header X-Frame-Options          "SAMEORIGIN"                          always;
add_header X-Content-Type-Options   "nosniff"                             always;
add_header Referrer-Policy          "strict-origin-when-cross-origin"     always;
add_header Permissions-Policy       "camera=(), microphone=(), geolocation=(), autoplay=(self), payment=()" always;

autoindex off;


# ============================================================
# ② Clean URL 重写（Nginx 优先级：精确 > 前缀 > 正则）
# ============================================================

# 独立页面
location = /setting     { try_files $uri $uri/ /setting.php; }
location = /apidoc      { try_files $uri $uri/ /apidoc.php; }
location = /status      { try_files $uri $uri/ /status.php; }
location = /sitemap     { try_files $uri $uri/ /sitemap.php; }
location = /sitemap.xml { try_files $uri $uri/ /sitemap.php; }
location = /debug       { try_files $uri $uri/ /debug.php; }
location = /stats       { try_files $uri $uri/ /stats.php; }

# API
location /api/ {
    try_files $uri $uri/ /api/index.php?$query_string;
}

# 平台 / archive / 短URL
location ~ ^/platform/([a-z0-9_]+)$                        { rewrite ^ /platform.php?source=$1 last; }
location ~ ^/platform/([a-z0-9_]+)/(\d\d\d\d-\d\d-\d\d)$   { rewrite ^ /platform.php?source=$1&date=$2 last; }
location ~ ^/archive/([a-z0-9_]+)$                         { rewrite ^ /archive.php?source=$1 last; }

# 短 URL 兜底（排除真实路径）
location ~ ^/([a-z0-9_]+)$ {
    set $src $1;
    if ($src ~ ^(platform|api|setting|sitemap|archive|status|apidoc|debug|stats|404)$) { break; }
    rewrite ^ /platform.php?source=$1 last;
}
location ~ ^/([a-z0-9_]+)/(\d\d\d\d-\d\d-\d\d)$ {
    set $src $1;
    if ($src ~ ^(platform|api|setting|sitemap|archive|status|apidoc|debug|stats|404)$) { break; }
    rewrite ^ /platform.php?source=$1&date=$2 last;
}


# ============================================================
# ③ 静态资源缓存
# ============================================================
location ~* \.(css|js)$                                 { add_header Cache-Control "no-cache, must-revalidate"; }
location ~* \.(woff2?|ttf|eot|svg|ico|png|jpg|jpeg|gif)$ { add_header Cache-Control "public, max-age=86400"; }
